# Copy to .env (never commit .env). Only local/dev values here; production uses GitHub Secrets + EC2 IAM role.
MODEL_SOURCE=local            # local | dvc
MODEL_ALIAS=champion
API_KEY=                      # set to require X-API-Key on POST /predict
LOG_LEVEL=INFO

# Needed only when MODEL_SOURCE=dvc outside EC2 (on EC2 use an IAM role instead of keys)
DVC_REMOTE_URL=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: remote MLflow server instead of local sqlite
MLFLOW_TRACKING_URI=
